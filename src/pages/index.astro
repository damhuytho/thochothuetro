---
import Layout from '../layouts/Layout.astro';

// Trang Landing Page: Chỉ dùng để điều hướng
const pageTitle = "Hệ thống phòng trọ Thọ Cho Thuê Trọ - Hà Nội & TP.HCM";
const pageDesc = "Hệ thống phòng trọ, căn hộ dịch vụ tiện nghi, giá rẻ tại Hà Nội và TP.HCM. Giờ giấc tự do, full nội thất.";

// Cấu hình Link ảnh Banner (Đảm bảo 2 ảnh này có trên R2 hoặc host ảnh của bạn)
const BANNER_HCM = "https://img.thochothuetro.com/banner-mobile.webp";
const BANNER_HN  = "https://img.thochothuetro.com/banner.webp";
---

<Layout title={pageTitle} description={pageDesc} isLanding={true}>
    <section class="landing-hero d-flex align-items-center justify-content-center">
        <div class="overlay"></div>
        <div class="content text-center position-relative z-2 container">
            <img src="/logo.png" alt="Logo Thọ Cho Thuê Trọ" width="120" class="mb-4 animate-up logo-landing">
            
            <h1 class="text-white fw-bold text-uppercase mb-3 animate-up delay-1">
                Chào mừng bạn đến với <br> <span class="text-warning">Thọ Cho Thuê Trọ</span>
            </h1>
            
            <p class="text-white-50 mb-5 fs-5 animate-up delay-2" style="max-width: 600px; margin: 0 auto;">
                Vui lòng chọn khu vực bạn muốn tìm phòng
            </p>

            <div class="row g-2 g-md-4 justify-content-center"> 
    
    <div class="col-6 col-md-5 col-lg-4">
        <a href="/ho-chi-minh" class="city-card card border-0 rounded-4 overflow-hidden text-decoration-none shadow-lg">
            <div class="city-img-wrapper">
                <img 
                    src={BANNER_HCM} 
                    alt="Phòng trọ Hồ Chí Minh" 
                    class="w-100 h-100 object-fit-cover city-img"
                    width="400" height="300"
                    fetchpriority="high"
                    loading="eager"
                    decoding="sync"
                >
                <div class="city-overlay d-flex flex-column align-items-center justify-content-center p-2 text-center">
                    <h2 class="h5 h3-md fw-bold text-white m-0">TP.HCM</h2>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-5 col-lg-4">
        <a href="/ha-noi" class="city-card card border-0 rounded-4 overflow-hidden text-decoration-none shadow-lg">
            <div class="city-img-wrapper">
                <img 
                    src={BANNER_HN} 
                    alt="Phòng trọ Hà Nội" 
                    class="w-100 h-100 object-fit-cover city-img"
                    width="400" height="300"
                    fetchpriority="high"
                    loading="eager"
                    decoding="sync"
                >
                <div class="city-overlay d-flex flex-column align-items-center justify-content-center p-2 text-center">
                    <h2 class="h5 h3-md fw-bold text-white m-0">HÀ NỘI</h2>
                </div>
            </div>
        </a>
    </div>
</div>
        </div>
    </section>
</Layout>

<style>
    .logo-landing {
        width: 120px;       /* Chiều rộng cố định */
        height: auto;       /* Chiều cao tự động tính toán (quan trọng) */
        object-fit: contain; /* Đảm bảo ảnh nằm gọn gàng */
        display: inline-block;
    }
    @media (max-width: 768px) {
        .logo-landing { width: 100px; }
    }
    .landing-hero {
        position: relative;
        min-height: 100vh;
        background-color: #1a1a1a;
        /* Ảnh nền chung cho cả trang landing */
        background-image: url('https://img.thochothuetro.com/banner.webp');
        background-size: cover;
        background-position: center;
        overflow: hidden;
    }
    .overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.7);
        backdrop-filter: blur(8px);
    }
    .city-card { transition: transform 0.3s ease; }
    .city-card:hover { transform: translateY(-10px); }
    
    .city-img-wrapper { 
        position: relative; 
        height: 200px; /* Mobile cao 200px thôi */
    }
    .city-img { transition: transform 0.5s ease; }
    .city-card:hover .city-img { transform: scale(1.1); }
    
    .city-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.5);
        transition: background 0.3s;
    }
    .city-card:hover .city-overlay { background: rgba(0,0,0,0.3); }
    /* Desktop thì cao 300px như cũ */
    @media (min-width: 768px) {
        .city-img-wrapper { height: 300px; }
        .fa-md-3x { font-size: 3em; } /* Icon to trên desktop */
        .h3-md { font-size: 1.75rem; } /* Chữ to trên desktop */
    }
    /* Animation */
    .animate-up { opacity: 0; transform: translateY(30px); animation: fadeInUp 0.8s forwards; }
    .delay-1 { animation-delay: 0.2s; }
    .delay-2 { animation-delay: 0.4s; }
    .delay-3 { animation-delay: 0.6s; }

    @keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    }
    @media (max-width: 768px) {
        .animate-up {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }
</style>