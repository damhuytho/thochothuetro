---
import Layout from "../layouts/Layout.astro";

// --- SEO METADATA ---
const pageTitle =
  "Liên hệ Thọ Cho Thuê Trọ - Tìm Phòng & Ký Gửi (Tân Bình, Phú Nhuận)";
const pageDesc =
  "Liên hệ ngay 0925 996 992 (Zalo) để tìm phòng trọ, căn hộ dịch vụ ưng ý. Nhận ký gửi vận hành phòng trọ uy tín, lấp đầy phòng nhanh chóng tại TP.HCM.";
const siteURL = Astro.site || "https://thochothuetro.com";

// --- SCHEMA LOCAL BUSINESS (SEO) ---
const schemaLocalBusiness = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Thọ Cho Thuê Trọ",
  image: `${siteURL}/logo.png`,
  telephone: "0925 996 992",
  url: `${siteURL}/contact`,
  email: "thochothuetro@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Tân Bình",
    addressRegion: "Thành phố Hồ Chí Minh",
    addressCountry: "VN",
  },
  areaServed: ["Tân Bình", "Phú Nhuận"],
  priceRange: "3000000VND-15000000VND",
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "08:00",
    closes: "21:00",
  },
};
---

<Layout title={pageTitle} description={pageDesc} image="/logo.png">
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(schemaLocalBusiness)}
  />

  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:title" content={pageTitle} />
  <meta slot="head" property="og:description" content={pageDesc} />
  <meta slot="head" property="og:url" content={`${siteURL}/contact`} />
  <meta slot="head" property="og:site_name" content="Thọ Cho Thuê Trọ" />

  <div class="bg-light py-4 border-bottom">
    <div class="container text-center">
      <h1 class="fw-bold text-uppercase mb-2 text-dark">Liên hệ & Hỗ trợ</h1>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb justify-content-center mb-0 small">
          <li class="breadcrumb-item">
            <a href="/" class="text-decoration-none text-muted">Trang chủ</a>
          </li>
          <li
            class="breadcrumb-item active text-warning fw-bold"
            aria-current="page"
          >
            Liên hệ
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="container py-5">
    <div class="row g-4">
      <div class="col-lg-5">
        <div
          class="bg-white p-4 rounded-3 shadow-sm border h-100 position-relative overflow-hidden"
        >
          <div
            class="position-absolute top-0 start-0 w-100 bg-warning"
            style="height: 5px;"
          >
          </div>

          <h4
            class="fw-bold mb-4 text-uppercase border-start border-4 border-warning ps-3"
          >
            Thông tin kết nối
          </h4>

          <div
            class="d-flex align-items-center mb-3 p-3 rounded bg-light border border-light-subtle contact-card"
          >
            <div
              class="bg-white rounded-circle p-3 me-3 text-warning shadow-sm d-flex align-items-center justify-content-center icon-box"
            >
              <i class="fas fa-phone-alt fa-lg"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-1 text-dark text-uppercase small">
                Hotline / Zalo (24/7)
              </h6>
              <a
                href="tel:0925996992"
                class="text-danger fw-bold fs-4 text-decoration-none d-block lh-1"
                >0925 996 992</a
              >
            </div>
          </div>

          <div
            class="d-flex align-items-center mb-3 p-3 rounded bg-light border border-light-subtle contact-card"
          >
            <div
              class="bg-white rounded-circle p-3 me-3 text-warning shadow-sm d-flex align-items-center justify-content-center icon-box"
            >
              <i class="fas fa-envelope fa-lg"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-1 text-dark text-uppercase small">
                Email hỗ trợ
              </h6>
              <div class="fw-bold text-dark text-break">
                thochothuetro@gmail.com
              </div>
            </div>
          </div>

          <div
            class="d-flex align-items-center mb-4 p-3 rounded bg-light border border-light-subtle contact-card"
          >
            <div
              class="bg-white rounded-circle p-3 me-3 text-warning shadow-sm d-flex align-items-center justify-content-center icon-box"
            >
              <i class="fas fa-map-marked-alt fa-lg"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-1 text-dark text-uppercase small">
                Khu vực hoạt động
              </h6>
              <div class="fw-bold text-dark">Quận Tân Bình, Phú Nhuận</div>
              <div class="small text-muted">TP. Hồ Chí Minh</div>
            </div>
          </div>

          <div
            class="mb-4 rounded overflow-hidden border shadow-sm position-relative map-facade"
            id="map-container"
          >
            <div
              id="map-placeholder"
              class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center bg-light"
              style="z-index: 2;"
            >
              <div class="text-muted mb-2">
                <i class="fas fa-map-marked-alt fa-3x opacity-25"></i>
              </div>
              <button
                id="btn-load-map"
                class="btn btn-sm btn-outline-warning fw-bold bg-white text-dark shadow-sm"
              >
                <i class="fas fa-download me-1"></i> Bấm để tải bản đồ
              </button>
            </div>
            <div id="contact-map" style="height: 100%; width: 100%;"></div>
          </div>

          <hr class="my-4 opacity-25" />

          <div class="text-center">
            <p class="fw-bold mb-3 small text-uppercase text-muted">
              Quét mã Zalo để nhận báo giá
            </p>
            <div
              class="d-inline-block border p-2 rounded bg-white shadow-sm mb-3 position-relative qr-wrapper"
            >
              <img
                src="/images/qr-zalo.png"
                alt="QR Zalo 0925996992"
                width="120"
                height="120"
                decoding="async"
                loading="lazy"
              />
            </div>
            <div class="d-grid gap-2">
              <a
                href="https://zalo.me/0925996992"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary fw-bold rounded-pill shadow-sm border-0 btn-pulse-blue"
                style="background-color: #0068ff;"
              >
                <i class="fas fa-comment-dots me-2"></i> Chat Zalo Ngay
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-7">
        <div
          class="bg-white p-5 rounded-3 shadow-sm border h-100 d-flex flex-column justify-content-center align-items-center text-center"
        >
          <div class="mb-4 text-warning">
            <i class="fas fa-user-clock fa-4x opacity-75"></i>
          </div>
          <h3 class="fw-bold text-dark mb-3">Kết nối trực tiếp với Thọ</h3>
          <p class="text-muted mb-4 fs-6" style="max-width: 500px;">
            Hệ thống biểu mẫu đang được nâng cấp để phục vụ tốt hơn.<br />
            Để tìm phòng nhanh nhất và nhận báo giá chính xác, bạn vui lòng nhắn tin
            trực tiếp qua Zalo hoặc gọi điện ngay nhé!
          </p>

          <div class="d-flex gap-3 flex-wrap justify-content-center">
            <a
              href="https://zalo.me/0925996992"
              target="_blank"
              class="btn btn-primary btn-lg rounded-pill fw-bold px-4 shadow-sm d-flex align-items-center gap-2"
            >
              <i class="fas fa-comment text-white"></i> Chat Zalo
            </a>
            <a
              href="tel:0925996992"
              class="btn btn-outline-dark btn-lg rounded-pill fw-bold px-4 shadow-sm d-flex align-items-center gap-2"
            >
              <i class="fas fa-phone-alt"></i> Gọi điện ngay
            </a>
          </div>

          <div
            class="mt-5 p-3 bg-light rounded border w-100"
            style="max-width: 500px;"
          >
            <div class="d-flex align-items-center gap-3 text-start">
              <div class="flex-shrink-0">
                <img
                  src="/logo.png"
                  alt="Thọ cho thuê trọ"
                  width="50"
                  height="50"
                  class="rounded-circle border"
                />
              </div>
              <div>
                <h6 class="fw-bold mb-1">Thọ Cho Thuê Trọ</h6>
                <p class="mb-0 small text-success">
                  <i class="fas fa-circle me-1" style="font-size: 8px;"></i>Đang
                  online sẵn sàng hỗ trợ
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(h1, h2, h3, h4, h5, h6, p, span, a) {
    font-display: swap;
  }
  /* 1. ANIMATION PULSE */
  .btn-pulse-blue {
    animation: pulse-blue 2s infinite;
  }
  @keyframes pulse-blue {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 104, 255, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(0, 104, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 104, 255, 0);
    }
  }

  /* 2. CONTACT CARD HOVER */
  .contact-card {
    transition: all 0.3s ease;
  }
  .contact-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    border-color: #f1c40f !important;
  }

  /* 3. QR SCAN EFFECT */
  .qr-wrapper {
    position: relative;
    overflow: hidden;
  }
  .qr-scan-line {
    position: absolute;
    width: 100%;
    height: 2px;
    background: #f1c40f;
    box-shadow: 0 0 4px #f1c40f;
    top: 0;
    left: 0;
    animation: scan 2s infinite linear;
  }
  @keyframes scan {
    0% {
      top: 0;
    }
    50% {
      top: 100%;
    }
    100% {
      top: 0;
    }
  }

  /* 4. MAP FACADE */
  .map-facade {
    height: 200px;
    background-color: #e9ecef;
  }
  .icon-box {
    width: 60px;
    height: 60px;
  }

  /* LEAFLET */
  .custom-map-marker-yellow {
    filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.3));
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnLoadMap = document.getElementById("btn-load-map");
    const placeholder = document.getElementById("map-placeholder");
    const mapContainer = document.getElementById("contact-map");

    if (!btnLoadMap || !mapContainer) return;

    // Hàm tải map thật (Chỉ chạy khi user bấm nút)
    const initRealMap = () => {
      // Hiệu ứng chuyển đổi
      btnLoadMap.innerHTML =
        '<div class="spinner-border spinner-border-sm text-dark" role="status"></div> Đang tải...';

      const startLoad = () => {
        // Ẩn placeholder
        if (placeholder) placeholder.style.display = "none";

        // Khởi tạo Map
        const map = L.map("contact-map", {
          zoomControl: false,
          scrollWheelZoom: false,
          dragging: !L.Browser.mobile,
        }).setView([10.7992, 106.6814], 13);

        // Sử dụng bản đồ nền CARTO Voyager để đồng bộ với trang Tìm kiếm
        L.tileLayer(
          "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
          {
            attribution: "&copy; OpenStreetMap &copy; CARTO",
            maxZoom: 20,
            subdomains: "abcd",
          },
        ).addTo(map);

        const iconHTML =
          '<div style="background:#f1c40f; width:30px; height:30px; border-radius:50%; border:2px solid white; display:flex; align-items:center; justify-content:center; box-shadow:0 3px 5px rgba(0,0,0,0.3); color:#1a1a1a;"><i class="fas fa-home" style="font-size:14px;"></i></div>';
        const brandIcon = L.divIcon({
          className: "custom-map-marker-yellow",
          html: iconHTML,
          iconSize: [30, 30],
          iconAnchor: [15, 15],
        });

        L.marker([10.801646, 106.663158], { icon: brandIcon }).addTo(map); // Tân Bình
        L.marker([10.793781, 106.684175], { icon: brandIcon }).addTo(map); // Phú Nhuận
      };

      // Tải thư viện động
      if (typeof L === "undefined") {
        const script = document.createElement("script");
        script.src = "/libs/leaflet/leaflet.js";
        script.onload = () => {
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = "/libs/leaflet/leaflet.css";
          document.head.appendChild(link);
          setTimeout(startLoad, 50);
        };
        document.head.appendChild(script);
      } else {
        startLoad();
      }
    };

    // Gán sự kiện click
    btnLoadMap.addEventListener("click", initRealMap);
  });
</script>
