---
import Layout from '../../layouts/Layout.astro';
import CommitmentSidebar from '../../components/CommitmentSidebar.astro';
import CardRoom from '../../components/CardRoom.astro';
import fs from 'node:fs';
import path from 'node:path';
import { formatPrice, hideNumber } from '../../utils/helpers.js';

// --- 1. HELPER: TẠO SLUG ---
function createSlug(str) {
    if (!str) return '';
    return str.toString().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9\s]/g, '')
        .trim()
        .replace(/\s+/g, '-');
}

// --- 2. GET STATIC PATHS ---
export async function getStaticPaths() {
  const dataPath = path.join(process.cwd(), 'public', 'data.json');
  const jsonData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  const activeRooms = jsonData.rooms.filter(r => r.status === 'active');

  return activeRooms.map((room) => {
      const districtSlug = room.district.toString().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '-');
        
      return {
        params: { district: districtSlug, id: room.id },
        props: { room, allRooms: activeRooms },
      };
  });
}

// --- 3. XỬ LÝ DỮ LIỆU PAGE ---
const { room, allRooms } = Astro.props;
const currentDistrictSlug = createSlug(room.district);

// --- LOGIC ẢNH TỐI ƯU (Gallery & Collage) ---
function filterImages(sourceArr, keyword) {
    return (sourceArr || []).filter(img => img.includes(keyword));
}

// 1. Xử lý Main Gallery
const detailSource = room.image_detail || [];
const collageSource = room.image_collage || [];

// Lấy ảnh Web
let imagesWeb = filterImages(detailSource, '_web');
// Nếu thiếu ảnh detail, lấy bù từ collage
if (imagesWeb.length < 6) {
    const collageWeb = filterImages(collageSource, '_web');
    // Chỉ lấy thêm những ảnh chưa tồn tại để tránh trùng
    const uniqueCollage = collageWeb.filter(img => !imagesWeb.includes(img));
    imagesWeb = [...imagesWeb, ...uniqueCollage];
}
imagesWeb = imagesWeb.slice(0, 6);

// Lấy ảnh Mobile (Medium) tương ứng
let imagesMobile = filterImages(detailSource, '_medium');
// Fallback: Nếu không có medium thì dùng web
if (imagesMobile.length === 0) imagesMobile = imagesWeb;
// Nếu thiếu số lượng mobile, lấy bù từ web (để đảm bảo map index không lỗi)
if (imagesMobile.length < imagesWeb.length) {
    // Lấy thêm từ nguồn web cho đủ số lượng
    const diff = imagesWeb.length - imagesMobile.length;
    const fillers = imagesWeb.slice(-diff); // Lấy những ảnh cuối của web đắp vào
    imagesMobile = [...imagesMobile, ...fillers];
}
imagesMobile = imagesMobile.slice(0, imagesWeb.length);
// Ảnh đại diện (LCP)
const mainImageWeb = imagesWeb[0] || '/logo.png';
const mainImageMobile = imagesMobile[0] || mainImageWeb;

// 2. Xử lý Collage Banner (Ảnh tiện ích) - ĐÃ FIX MOBILE
const collageListWeb = filterImages(collageSource, '_web');
const collageListMobile = filterImages(collageSource, '_medium');

// Ưu tiên lấy ảnh collage, nếu không có lấy ảnh thứ 2 trong gallery
const collageImageWeb = collageListWeb[0] || (imagesWeb.length > 1 ? imagesWeb[1] : null);
// Logic mobile: Tìm medium tương ứng, nếu không có thì fallback về web
const collageImageMobile = collageListMobile[0] || collageImageWeb;

// --- DỮ LIỆU TEXT ---
const cleanAddress = hideNumber(room.address);
const rawKeypoints = room.keypoint ? room.keypoint.split(',') : [];

const keypointsList = rawKeypoints.map(k => {
    let text = k.split('|')[0].trim();
    return text.replace(/^(🎁|KM|Khuyến mãi|:\s*)+/i, '').trim();
}).filter(k => k !== '');

const highlightFeature = keypointsList.find(k => 
    /ban công|cửa sổ|duplex|thang máy|tách bếp/i.test(k)
) || keypointsList[0] || 'Full nội thất';

// --- SEO META & ALT TEXT ---
const pageTitle = `Cho thuê ${room.type} ${cleanAddress}, ${highlightFeature} - Giá ${formatPrice(room.price)}`;
const pageDesc = `🔥 Chỉ ${formatPrice(room.price)}/tháng. Cho thuê ${room.type} tại ${room.district} (${cleanAddress}). ✅ ${keypointsList.slice(0, 3).join(', ')}. ☎️ 0925 996 992.`;
const canonicalURL = `${Astro.site || 'https://thochothuetro.com'}/${currentDistrictSlug}/${room.id}`;

// Tạo Alt Text chuẩn SEO dùng chung
const baseAltText = `Phòng trọ ${room.type} tại ${cleanAddress}, ${room.district}`;

// Video helper
function getVideoId(url) {
    if (!url) return null;
    const match = url.match(/(?:youtu\.be\/|youtube\.com(?:\/embed\/|\/v\/|\/watch\?v=|\/shorts\/))([\w-]{11})/);
    return match ? match[1] : null;
}
const videoId = getVideoId(room.video);

// --- SCHEMA JSON-LD ---
const schemaProduct = {
  "@context": "https://schema.org",
  "@type": "Apartment",
  "name": pageTitle,
  "description": pageDesc,
  "image": imagesWeb,
  "numberOfRooms": room.type.includes('2PN') ? 2 : 1,
  "petsAllowed": room.pet ? true : false,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": cleanAddress,
    "addressLocality": `Quận ${room.district}`,
    "addressRegion": "Hồ Chí Minh",
    "addressCountry": "VN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": room.lat, "longitude": room.lng },
  "offers": {
    "@type": "Offer",
    "url": canonicalURL,
    "priceCurrency": "VND",
    "price": room.price,
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Person", "name": "Thọ Cho Thuê Trọ", "telephone": "0925996992" }
  }
};

const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://thochothuetro.com/" },
    { "@type": "ListItem", "position": 2, "name": `Quận ${room.district}`, "item": `https://thochothuetro.com/${currentDistrictSlug}` },
    { "@type": "ListItem", "position": 3, "name": room.room_code, "item": canonicalURL }
  ]
};

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { q: `Giá phòng mã ${room.room_code}?`, a: `${formatPrice(room.price)}/tháng (có thương lượng).` },
    { q: `Địa chỉ ở đâu?`, a: `${cleanAddress}, Quận ${room.district}.` },
    { q: `Có cho nuôi Pet không?`, a: room.pet ? "Có cho phép nuôi thú cưng." : "Hiện tại chưa hỗ trợ nuôi thú cưng." }
  ].map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } }))
};

// Related Rooms Logic
const relatedRooms = allRooms.filter(r => 
    r.district === room.district && r.id !== room.id && Math.abs(r.price - room.price) <= 1500000
).sort((a, b) => (b.image_detail?.length || 0) - (a.image_detail?.length || 0)).slice(0, 6);
---

<Layout title={pageTitle} description={pageDesc} image={mainImageWeb} preloadImage={mainImageMobile}>
    
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaProduct)} />
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaBreadcrumb)} />
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaFAQ)} />

    <meta slot="head" property="og:type" content="website" />
    <meta slot="head" property="og:title" content={pageTitle} />
    <meta slot="head" property="og:description" content={pageDesc} />
    <meta slot="head" property="og:image" content={mainImageWeb} />
    <meta slot="head" property="og:url" content={canonicalURL} />
    
    <div class="bg-white border-bottom mb-4 shadow-sm sticky-top-mobile" style="z-index: 1020; padding-top: 10px; padding-bottom: 10px;">
        <div class="container text-center">
            
            <h1 class="h5 fw-bold mb-2 text-dark text-uppercase d-none d-md-block" style="line-height: 1.4;">
                {pageTitle}
            </h1>

            <div class="d-md-none">
                <h1 class="h6 fw-bold mb-1 text-dark" style="font-size: 15px;">
                    {room.type} {room.room_code} <span class="text-danger mx-1">•</span> {formatPrice(room.price)}
                </h1>
                <div class="small text-muted" style="font-size: 13px;">
                    <i class="fas fa-map-marker-alt text-warning me-1"></i> {cleanAddress}
                </div>
            </div>
            
            <nav aria-label="breadcrumb" class="d-none d-md-block">
                 <ol class="breadcrumb mb-0 small justify-content-center">
                     <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                     <li class="breadcrumb-item"><a href={`/${currentDistrictSlug}`} class="text-decoration-none text-muted">{room.district}</a></li>
                     <li class="breadcrumb-item active text-warning fw-bold" aria-current="page">{room.room_code}</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container pb-5 detail-container-standard">
        <div class="row g-4">
            <div class="col-lg-8">
                
                <div class="mb-4 bg-white rounded-3 overflow-hidden border shadow-sm">
                    {imagesWeb.length > 0 ? (
                        <div class="gallery-wrapper">
                            <div id="gallery-main-frame" class="position-relative bg-dark" style="aspect-ratio: 4/3; width: 100%; overflow: hidden;">
                                <picture>
                                    <source media="(max-width: 767px)" srcset={mainImageMobile} />
                                    <img 
                                        src={mainImageWeb} 
                                        id="main-image" 
                                        class="w-100 h-100 d-block" 
                                        style="object-fit: contain;" 
                                        alt={`${baseAltText} - Ảnh chính`}
                                        width="800" 
                                        height="600"
                                        fetchpriority="high" 
                                        loading="eager" 
                                        decoding="sync" 
                                    />
                                </picture>
                                
                                <div class="position-absolute bottom-0 end-0 m-3 px-3 py-1 bg-dark bg-opacity-75 text-white rounded-pill small">
                                    <i class="fas fa-camera me-1"></i> {imagesWeb.length} ảnh
                                </div>
                            </div>

                            <div class="d-flex gap-2 p-2 overflow-auto bg-white border-top custom-scrollbar">
                                {imagesWeb.map((imgWeb, index) => {
                                    const imgMobile = imagesMobile[index] || imgWeb;
                                    return (
                                        <img 
                                            src={imgMobile} 
                                            class={`rounded border cursor-pointer gallery-thumb ${index === 0 ? 'active' : ''}`}
                                            style="width: 80px; height: 60px; object-fit: cover; flex-shrink: 0;"
                                            onclick={`changeImage('${imgWeb}', '${imgMobile}', this)`}
                                            loading="lazy" 
                                            decoding="async"
                                            width="80" 
                                            height="60"
                                            alt={`${baseAltText} - Hình ${index + 1}`} 
                                        />
                                    )
                                })}
                            </div>
                        </div>
                    ) : (
                        <div class="d-flex align-items-center justify-content-center p-5 text-muted bg-light" style="aspect-ratio: 4/3;">
                            Hình ảnh đang cập nhật
                        </div>
                    )}
                </div>

                <div class="mb-4 bg-white p-4 rounded-3 border shadow-sm">
                    <div class="d-flex align-items-baseline mb-2 flex-wrap gap-2">
                         <h2 class="fw-bold text-danger m-0" style="font-size: 1.8rem;">{formatPrice(room.price)}</h2>
                         <span class="text-muted small fst-italic">/tháng</span>
                    </div>
                    
                    {room.promotion && (
                        <div class="mb-3 animate-pulse">
                             <div class="px-3 py-2 rounded-2 text-dark fw-bold d-inline-block border border-warning bg-warning bg-opacity-10">
                                <i class="fas fa-gift text-danger me-2"></i> {room.promotion}
                            </div>
                        </div>
                    )}
                    
                    <hr class="text-muted opacity-25 my-3" />
                    
                    <h3 class="h6 fw-bold text-uppercase text-secondary mb-3">Tiện ích nổi bật</h3>
                    <div class="row g-2">
                         {keypointsList.map((k) => (
                             <div class="col-6 col-sm-4">
                                 <div class="d-flex align-items-start text-secondary small">
                                     <i class="fas fa-check-circle text-success me-2 mt-1 flex-shrink-0"></i>
                                     <span style="line-height: 1.4;">{k}</span>
                                 </div>
                             </div>
                        ))}
                    </div>
                </div>

                {collageImageWeb && (
                    <div class="mb-4 rounded-3 overflow-hidden shadow-sm">
                        <picture>
                            <source media="(max-width: 767px)" srcset={collageImageMobile} />
                            <img 
                                src={collageImageWeb} 
                                class="w-100 h-auto d-block" 
                                loading="lazy" 
                                alt={`Tiện nghi và không gian ${baseAltText}`} 
                            />
                        </picture>
                    </div>
                )}

                <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
                    <h3 class="h6 fw-bold border-bottom pb-2 mb-3 text-uppercase text-secondary">
                        <i class="fas fa-align-left me-2"></i> Mô tả chi tiết
                    </h3>
                    <div class="content-text" style="white-space: pre-line; line-height: 1.7; color: #444;">
                        {room.desc}
                    </div>
                </div>

                {videoId && (
                    <div class="d-lg-none mb-4">
                        <div class="card shadow-sm border-0">
                             <div class="card-header bg-warning text-dark fw-bold py-2 small text-uppercase">
                                 <i class="fas fa-play-circle me-2"></i> Video thực tế
                             </div>
                             <div class="ratio ratio-9x16 bg-light position-relative cursor-pointer video-facade" data-id={videoId}>
                                <img 
                                    src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} 
                                    class="w-100 h-100 object-fit-cover" 
                                    loading="lazy" 
                                    alt="Video thumb" 
                                />
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-25">
                                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 50px; height: 50px;">
                                        <i class="fas fa-play fs-5 ms-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                     </div>
                )}

                <div class="bg-white p-4 rounded-3 border shadow-sm mb-4 border-warning position-relative overflow-hidden">
                    <div class="position-absolute top-0 start-0 h-100 bg-warning" style="width: 4px;"></div>
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center mb-3 mb-md-0 border-end-md">
                            <img src="/logo.png" width="80" height="80" class="rounded-circle border border-2 border-warning p-1 mb-2" alt="Avatar">
                            <h6 class="fw-bold mb-1">Thọ Cho Thuê Trọ</h6>
                            <span class="badge bg-light text-secondary border rounded-pill px-3 small">Quản lý vận hành</span>
                        </div>
                        
                        <div class="col-md-8 ps-md-4">
                            <h5 class="fw-bold mb-2">👋 Xin chào bạn,</h5>
                            <p class="text-muted mb-3" style="font-size: 1.05rem;">
                               Mình cam kết <strong>hình ảnh và giá cả là chính xác 100%</strong>.<br>
                               Mình luôn sẵn sàng hỗ trợ bạn xem phòng bất cứ lúc nào (miễn phí).
                            </p>
                            
                            <div class="d-flex gap-2">
                                <a href="tel:0925996992" class="btn btn-warning flex-grow-1 fw-bold rounded-pill shadow-sm text-dark btn-pulse">
                                    <i class="fas fa-phone-alt me-2"></i> 0925 996 992
                                </a>
                                <a href="https://zalo.me/0925996992" target="_blank" class="btn btn-primary flex-grow-1 fw-bold rounded-pill shadow-sm border-0" style="background-color: #0068ff;">
                                    Chat Zalo
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-3 border shadow-sm mb-4">
                    <h3 class="h6 fw-bold mb-3 text-uppercase text-dark border-start border-4 border-warning ps-3">Vị trí</h3>
                    <div id="map-container" class="rounded overflow-hidden position-relative bg-light border" style="height: 300px;">
                        <div id="map-placeholder" class="w-100 h-100 d-flex flex-column align-items-center justify-content-center cursor-pointer position-relative" onclick={`loadMap(this, ${room.lat}, ${room.lng}, '${cleanAddress}')`}>
                            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: url('https://img.thochothuetro.com/map_detail_demo_1_11zon.webp') center/cover no-repeat; filter: blur(1px);"></div>
                            <div class="position-absolute top-0 start-0 w-100 h-100 bg-white opacity-50"></div>
                            
                            <div class="position-relative z-1 text-center p-3">
                                <div class="bg-white rounded-circle shadow-sm p-3 d-inline-block mb-2">
                                    <i class="fas fa-map-marker-alt text-danger fs-4"></i>
                                </div>
                                <h4 class="h6 fw-bold text-dark">{cleanAddress}</h4>
                                <button class="btn btn-warning btn-sm rounded-pill fw-bold mt-2 shadow-sm px-4">
                                    Xem bản đồ
                                </button>
                            </div>
                        </div>
                        <div id="real-map" class="w-100 h-100 d-none"></div>
                    </div>
                </div>

                <div class="mt-5">
                    <h3 class="h5 fw-bold border-bottom border-warning pb-2 mb-4 text-uppercase">Phòng tương tự</h3>
                    <div class="row g-2 g-md-3">
                        {relatedRooms.length > 0 ? relatedRooms.map((r) => (
                            <div class="col-6 col-md-4"><CardRoom room={r} /></div>
                        )) : (
                            <div class="col-12 text-center text-muted small py-4">Đang cập nhật thêm phòng...</div>
                        )}
                    </div>
                </div>
            </div>

            <div class="col-lg-4 d-none d-lg-block">
                <div class="mb-4">
                    <CommitmentSidebar />
                </div>
                
                {videoId && (
                    <div class="sticky-top" style="top: 85px; z-index: 10;">
                        <div class="card shadow-sm border-0 overflow-hidden">
                            <div class="card-header bg-warning text-dark fw-bold py-2 small text-uppercase">
                                <i class="fas fa-video me-2"></i> Video thực tế
                            </div>
                            <div class="ratio ratio-9x16 bg-light cursor-pointer video-facade" data-id={videoId}>
                                <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} class="w-100 h-100 object-fit-cover" alt="Video thumb" />
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-25">
                                    <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center shadow-lg" style="width: 60px; height: 60px;">
                                        <i class="fas fa-play fs-4 ms-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    </div>
</Layout>

<style>
    /* CSS Tối ưu */
    .text-warning { color: #d9b205 !important; }
    .bg-warning { background-color: #ffc107 !important; }
    .cursor-pointer { cursor: pointer; }
    .ratio-9x16 { --bs-aspect-ratio: 177.78%; }
    
    .gallery-thumb.active { border: 2px solid #d9b205 !important; opacity: 1; }
    .gallery-thumb { opacity: 0.7; transition: opacity 0.2s; }
    
    .btn-pulse { animation: pulse-yellow 2s infinite; }
    @keyframes pulse-yellow {
        0% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(255, 193, 7, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0); }
    }

    @media (min-width: 768px) { .border-end-md { border-right: 1px dashed #dee2e6; } }
    @media (min-width: 1200px) { .detail-container-standard { max-width: 1140px; } }
    
    .animate-pulse { animation: pulse 2s infinite; }
</style>

<script is:inline>
    // 1. Gallery Switcher
    function changeImage(webSrc, mobileSrc, el) {
        const mainImg = document.getElementById('main-image');
        const source = mainImg.previousElementSibling; // Thẻ source trong picture
        
        if(source) source.srcset = mobileSrc;
        mainImg.src = webSrc;
        
        document.querySelectorAll('.gallery-thumb').forEach(t => t.classList.remove('active'));
        el.classList.add('active');
    }

    // 2. Map Loader
    window.loadMap = function(placeholder, lat, lng, text) {
        placeholder.innerHTML = '<div class="d-flex justify-content-center align-items-center h-100 bg-light"><div class="spinner-border text-warning"></div></div>';
        
        const executeMapInit = () => {
            const realMap = document.getElementById('real-map');
            placeholder.classList.add('d-none');
            realMap.classList.remove('d-none');
            realMap.style.display = 'block';
            
            if (realMap._leaflet_id) { return; }

            setTimeout(() => {
                try {
                    const map = L.map('real-map').setView([lat, lng], 16);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { 
                        attribution: '&copy; OSM',
                        maxZoom: 19
                    }).addTo(map);
                    
                    const icon = L.divIcon({
                        className: 'custom-pin',
                        html: '<div style="background:#d9b205;width:34px;height:34px;border-radius:50%;border:2px solid white;box-shadow:0 3px 10px rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:center;"><i class="fas fa-home" style="color:#000;font-size:16px;"></i></div>',
                        iconSize: [34, 34],
                        iconAnchor: [17, 34],
                        popupAnchor: [0, -35]
                    });
                    
                    L.marker([lat, lng], {icon: icon}).addTo(map)
                     .bindPopup(`<div class="text-center p-2"><b>${text}</b></div>`)
                     .openPopup();

                    map.invalidateSize();
                } catch (e) {
                    console.error("Lỗi khởi tạo map:", e);
                    placeholder.innerHTML = '<div class="text-danger p-3">Không thể tải bản đồ. Vui lòng thử lại sau.</div>';
                    placeholder.classList.remove('d-none');
                }
            }, 100);
        };

        if (typeof L === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js';
            script.onload = executeMapInit;
            script.onerror = () => { placeholder.innerHTML = 'Lỗi kết nối máy chủ bản đồ.'; };
            document.head.appendChild(script);
            
            const css = document.createElement('link');
            css.rel = 'stylesheet'; 
            css.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css';
            document.head.appendChild(css);
        } else {
            executeMapInit();
        }
    };

    // 3. Video Loader
    document.addEventListener('click', function(e) {
        const facade = e.target.closest('.video-facade');
        if (facade) {
            const id = facade.getAttribute('data-id');
            facade.innerHTML = `<iframe src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0" class="w-100 h-100 border-0" allow="autoplay" allowfullscreen></iframe>`;
            facade.classList.remove('video-facade');
        }
    });
</script>