---
import fs from 'node:fs';
import path from 'node:path';

// Helper tạo Slug
function createSlug(str: any) {
    if (!str) return '';
    return str.toString().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9\s]/g, '')
        .trim()
        .replace(/\s+/g, '-');
}

// Hàm đọc dữ liệu
function getDistricts(fileName: string) {
    try {
        const dataPath = path.join(process.cwd(), 'public', fileName);
        if (fs.existsSync(dataPath)) {
            const jsonData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
            const rooms: any[] = jsonData.rooms || [];
            return [...new Set(rooms.map((r: any) => r.district).filter((d: any) => d))].sort() as string[];
        }
    } catch (e) {
        console.error(`Error loading ${fileName}:`, e);
    }
    return [];
}

const hcmDistricts = getDistricts('data_hochiminh.json');
const hnDistricts = getDistricts('data_hanoi.json');
const { currentCity } = Astro.props;
