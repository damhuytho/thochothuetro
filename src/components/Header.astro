<script is:inline>
    // Hàm này chạy độc lập, không cần Bootstrap JS
    window.toggleMobileSubmenu = function(targetId, btnElement) {
        // 1. Lấy phần tử mục tiêu
        const targetEl = document.getElementById(targetId);
        const icon = btnElement.querySelector('.transition-icon');
        
        // 2. Kiểm tra trạng thái hiện tại (Đang mở hay đóng)
        const isClosed = targetEl.style.display === 'none';

        // 3. ĐÓNG TẤT CẢ CÁC MENU KHÁC (Cơ chế Accordion thủ công)
        // Tìm tất cả submenu
        const allSubmenus = document.querySelectorAll('.mobile-submenu');
        const allIcons = document.querySelectorAll('.toggle-btn .transition-icon');
        
        // Đóng hết lại
        allSubmenus.forEach(el => el.style.display = 'none');
        allIcons.forEach(ic => ic.style.transform = 'rotate(0deg)');

        // 4. MỞ MENU ĐƯỢC CHỌN (Nếu nó đang đóng)
        if (isClosed) {
            targetEl.style.display = 'block';
            // Hiệu ứng trượt nhẹ (Optional animation via CSS class if needed)
            if(icon) icon.style.transform = 'rotate(180deg)';
        }
    }
</script>

