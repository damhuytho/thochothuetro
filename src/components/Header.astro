---
import fs from 'node:fs';
import path from 'node:path';

// Nhận biến từ Layout truyền sang
const { currentCity } = Astro.props;

// --- [MỚI] LOGIC LẤY MENU ĐỘNG TỪ DATA (ĐÃ FIX TYPESCRIPT) ---
// Thêm : string[] để báo đây là danh sách các chuỗi ký tự
let menuDistricts: string[] = []; 
let citySlug = '';
let cityName = '';

let otherCityName = '';
let otherCitySlug = '';

// Thêm (str: any) để tránh lỗi "implicitly has an 'any' type"
function createSlug(str: any) {
    if (!str) return '';
    return str.toString().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9\s]/g, '')
        .trim()
        .replace(/\s+/g, '-');
}

if (currentCity) {
    citySlug = currentCity === 'hanoi' ? 'ha-noi' : 'ho-chi-minh';
    cityName = currentCity === 'hanoi' ? 'Hà Nội' : 'Hồ Chí Minh';
    
    otherCityName = currentCity === 'hanoi' ? 'Hồ Chí Minh' : 'Hà Nội';
    otherCitySlug = currentCity === 'hanoi' ? 'ho-chi-minh' : 'ha-noi';

    try {
        const fileName = currentCity === 'hanoi' ? 'data_hanoi.json' : 'data_hochiminh.json';
        const dataPath = path.join(process.cwd(), 'public', fileName);
        
        if (fs.existsSync(dataPath)) {
            const jsonData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
            // Thêm : any[] để TypeScript không bắt bẻ biến rooms
            const rooms: any[] = jsonData.rooms || [];

            // Logic lọc quận (đã an toàn với TypeScript)
            menuDistricts = [...new Set(rooms.map((r: any) => r.district).filter((d: any) => d))].sort() as string[];
        }
    } catch (e) {
        console.error("Error loading menu data:", e);
        menuDistricts = [];
    }
}
