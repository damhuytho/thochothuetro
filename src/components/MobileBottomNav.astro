---
const currentPath = Astro.url.pathname;
---

<div class="mobile-bottom-nav">
    <a href="/map-search" class={`nav-item-mobile ${currentPath.includes('map-search') ? 'active' : ''}`}>
        <i class="fas fa-map-marked-alt"></i>
        <span>Bản đồ</span>
    </a>

    <button id="mobile-share-btn" class="nav-item-mobile share-btn">
        <i class="fas fa-share-alt"></i>
        <span>Chia sẻ</span>
    </button>

    <a href="https://zalo.me/0925996992" target="_blank" class="nav-item-mobile zalo-btn">
        <i class="fas fa-comment-dots"></i>
        <span>Zalo</span>
    </a>
</div>

<style>
    /* Ẩn trên Desktop */
    @media (min-width: 992px) {
        .mobile-bottom-nav { display: none !important; }
    }

    /* Hiện trên Mobile */
    @media (max-width: 991px) {
        .mobile-bottom-nav {
            position: fixed;
            bottom: 0; left: 0; width: 100%; height: 68px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            display: flex; justify-content: space-around; align-items: center;
            z-index: 9000; padding-bottom: env(safe-area-inset-bottom);
        }

        .nav-item-mobile {
            flex: 1;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            text-decoration: none; border: none; background: none; padding: 8px 0;
            color: #8e8e93;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); 
            -webkit-tap-highlight-color: transparent;
        }

        .nav-item-mobile i { font-size: 22px; margin-bottom: 4px; }
        .nav-item-mobile span { font-size: 11px; font-weight: 500; letter-spacing: 0.2px; }
        
        /* Active State */
        .nav-item-mobile.active { color: #d9b205; }
        .nav-item-mobile.active span { font-weight: 700; }

        /* Button interactions */
        .nav-item-mobile.share-btn:active i { color: #28a745; transform: scale(1.1); }
        
        /* Zalo Button specific */
        .nav-item-mobile.zalo-btn { color: #0068ff; opacity: 0.9; }
        .nav-item-mobile.zalo-btn span { font-weight: 600; }
        
        .nav-item-mobile:not(.active):not(.zalo-btn):active { 
            color: #d9b205; transform: scale(0.95); 
        }
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const shareBtn = document.getElementById('mobile-share-btn');
        if (shareBtn) {
            shareBtn.addEventListener('click', async () => {
                const shareData = {
                    title: document.title,
                    text: 'Phòng trọ đẹp, giá tốt tại Tân Bình & Phú Nhuận:',
                    url: window.location.href
                };
                // Ưu tiên dùng Native Share của điện thoại
                if (navigator.share) {
                    try { 
                        await navigator.share(shareData); 
                    } catch (err) {
                        console.log('Share cancelled');
                    }
                } else {
                    // Fallback: Copy link
                    try { 
                        await navigator.clipboard.writeText(window.location.href);
                        alert('Đã sao chép liên kết!');
                    } catch (err) {
                        console.log('Copy failed');
                    }
                }
            });
        }
    });
</script>