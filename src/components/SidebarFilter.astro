---
import fs from 'node:fs';
import path from 'node:path';

// [MỚI] Nhận biết đang ở thành phố nào (Mặc định là HCM)
const { currentCity = 'hochiminh' } = Astro.props;

// 1. DATA SERVER-SIDE (CHẠY TRÊN SERVER)
let uniqueDistricts = [];
try {
    // Chọn file data tương ứng
    const fileName = currentCity === 'hanoi' ? 'data_hanoi.json' : 'data_hochiminh.json';
    const dataPath = path.join(process.cwd(), 'public', fileName);
    
    // Kiểm tra và đọc file
    if (fs.existsSync(dataPath)) {
        const jsonData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
        
        // Data mới đã phân loại sẵn, lấy trực tiếp
        const cityRooms = jsonData.rooms || [];

        // Lấy danh sách quận duy nhất
        uniqueDistricts = [...new Set(cityRooms.map(r => r.district).filter(d => d))].sort();
    }
} catch (error) {
    console.error(`Lỗi đọc file ${currentCity}:`, error);
    uniqueDistricts = [];
}

// 2. CONFIG DATA
const listTypes = ["Studio", "1PN", "2PN", "3PN", "Duplex", "Nguyên căn"];
const listPrices = [
    { label: "Dưới 5 triệu", value: "duoi-5" },
    { label: "Từ 5 - 8 triệu", value: "5to8" },
    { label: "Trên 8 triệu", value: "over8" }
];
const listAmenities = ["ban công", "cửa sổ", "tách bếp", "nuôi pet", "máy giặt riêng", "thang máy"];

// 3. GET CURRENT PARAMS (SERVER SIDE - Dùng Astro.url thay vì window)
const { searchParams } = Astro.url;
const currentDist = searchParams.get('district') || 'all';
const currentType = searchParams.get('type') || 'all';
const currentPrice = searchParams.get('price') || 'all';
const currentAms = searchParams.get('amenities') ? searchParams.get('amenities').split(',') : [];
---

<div id="mobile-filter-bar" class="mobile-filter-bar d-lg-none">
    <div class="container d-flex align-items-center h-100 px-3">
        <div class="filter-tags-scroll" id="filter-tags-container"></div>
        <button type="button" class="btn-reset-mobile ms-2" id="btn-clear-mobile">
            <i class="fas fa-redo-alt"></i>
        </button>
    </div>
</div>

<div class="sidebar-sticky-wrapper" id="sidebar-wrapper">
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        
        <div class="d-flex text-center fw-bold" style="font-size: 0.95rem;">
            <a href="/ha-noi" 
               class={`flex-fill py-3 text-decoration-none text-uppercase border-bottom ${currentCity === 'hanoi' ? 'bg-warning text-dark border-warning' : 'bg-light text-muted border-light-subtle'}`}
               style="transition: all 0.2s;">
               Hà Nội
            </a>

            <a href="/ho-chi-minh" 
               class={`flex-fill py-3 text-decoration-none text-uppercase border-bottom ${currentCity === 'hochiminh' ? 'bg-warning text-dark border-warning' : 'bg-light text-muted border-light-subtle'}`}
               style="transition: all 0.2s;">
               TP.Hồ Chí Minh
            </a>
        </div>
        <div class="card-body p-3 bg-white collapse show" id="filter-form-body">
            
            <form id="astro-filter-form">
                
                <div class="mb-3">
                    <label class="filter-label">QUẬN / HUYỆN</label>
                    
                    <div class="dropdown w-100">
                        <button class="btn btn-outline-warning text-dark w-100 d-flex justify-content-between align-items-center dropdown-toggle fw-bold bg-light-subtle" 
                                type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btn-display-district">
                            -- Tất cả --
                        </button>
                        <ul class="dropdown-menu w-100 shadow border-0" style="max-height: 450px; overflow-y: auto;">
                            <li><a class="dropdown-item active" href="#" data-value="all" onclick="selectItem(this, 'sb-district', 'btn-display-district')">-- Tất cả --</a></li>
                            {uniqueDistricts.map((dist) => (
                                <li>
                                    <a class="dropdown-item" href="#" data-value={dist} onclick="selectItem(this, 'sb-district', 'btn-display-district')"> {dist}</a>
                                </li>
                            ))}
                        </ul>
                        <input type="hidden" id="sb-district" value="all">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="filter-label">LOẠI PHÒNG</label>
                    <div class="dropdown w-100">
                        <button class="btn btn-white border w-100 d-flex justify-content-between align-items-center dropdown-toggle" 
                                type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btn-display-type">
                            -- Tất cả --
                        </button>
                        <ul class="dropdown-menu w-100 shadow border-0">
                            <li><a class="dropdown-item active" href="#" data-value="all" onclick="selectItem(this, 'sb-type', 'btn-display-type')">-- Tất cả --</a></li>
                            {listTypes.map((type) => (
                                <li>
                                    <a class="dropdown-item" href="#" data-value={type} onclick="selectItem(this, 'sb-type', 'btn-display-type')">{type}</a>
                                </li>
                            ))}
                        </ul>
                        <input type="hidden" id="sb-type" value="all">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="filter-label">MỨC GIÁ</label>
                    <div class="dropdown w-100">
                        <button class="btn btn-white border w-100 d-flex justify-content-between align-items-center dropdown-toggle" 
                                type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btn-display-price">
                            -- Tất cả --
                        </button>
                        
                        <ul class="dropdown-menu w-100 shadow border-0">
                            <li><a class="dropdown-item active" href="#" data-value="all" onclick="selectItem(this, 'sb-price', 'btn-display-price')">-- Tất cả --</a></li>
                            {listPrices.map((p) => (
                                <li>
                                    <a class="dropdown-item" href="#" data-value={p.value} onclick="selectItem(this, 'sb-price', 'btn-display-price')">{p.label}</a>
                                </li>
                            ))}
                        </ul>
                        <input type="hidden" id="sb-price" value="all">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="filter-label">TIỆN ÍCH</label>
                    <div class="row g-2">
                        {listAmenities.map((am) => (
                            <div class="col-6">
                                <label class="custom-check">
                                    <input type="checkbox" class="sb-amenity" value={am} checked={currentAms.includes(am)}>
                                    <span class="checkmark"></span> 
                                    <span class="text-capitalize">{am}</span>
                                </label>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" id="btn-apply" class="btn btn-warning flex-grow-1 fw-bold text-dark shadow-sm py-2">
                        ÁP DỤNG
                    </button>
                    <button type="button" id="btn-reset" class="btn btn-light border flex-grow-1 fw-bold text-dark shadow-sm py-2">
                        ĐẶT LẠI
                    </button>
                </div>

            </form>
        </div>

        <div id="toggle-filter-btn-container" class="p-3 bg-white border-top">
            <button type="button" id="btn-toggle-filter" class="btn bg-white border border-dark w-100 fw-bold text-dark shadow-sm py-2">
                <i class="fas fa-chevron-down me-2"></i> HIỂN THỊ BỘ LỌC
            </button>
        </div>
    </div>
</div>

<style is:global>
:global(aside .sidebar-sticky-wrapper) {
    height: fit-content;
}

:global(aside > div), :global(aside > astro-island) {
    display: flex;
    flex-direction: column;
    height: 100%;
}
    .sidebar-sticky-wrapper {
        position: -webkit-sticky !important;
        position: sticky !important;
        top: 80px;
        z-index: 90;
        height: fit-content;
        max-height: calc(100vh - 100px);     
        overflow-y: auto;
    }
    
    .sidebar-sticky-wrapper::-webkit-scrollbar { width: 4px; }
    .sidebar-sticky-wrapper::-webkit-scrollbar-thumb { background: #eee; border-radius: 4px; }

    .custom-check { 
        display: flex;
        align-items: center; 
        cursor: pointer; 
        font-size: 1rem; 
        margin-bottom: 4px; 
        font-weight: 400;
    }

    .btn-white { background: white; color: #333; }
    .btn-white:hover, .btn-white:focus { background: #f8f9fa; border-color: #f1c40f !important; }
    .dropdown-item.active, .dropdown-item:active { background-color: #f1c40f; color: #000; font-weight: 600; }
    .dropdown-menu { font-size: 0.9rem; margin-top: 5px !important; border-radius: 8px; }
    
    .mobile-filter-bar {
        position: fixed;
        top: 0; left: 0; width: 100%; height: auto; min-height: 60px; 
        background: #fff; z-index: 2000; box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        border-bottom: 1px solid #eee; cursor: pointer; display: none; padding: 8px 0;
    }
    .mobile-filter-bar.is-visible { display: block !important; animation: slideDown 0.3s ease-out; }
    .mobile-filter-bar .container { display: flex; align-items: flex-start; justify-content: space-between; height: 100%; }
    @keyframes slideDown { from { transform: translateY(-100%); } to { transform: translateY(0); } }
    
    .filter-tags-scroll { flex: 1; display: flex; flex-wrap: wrap; white-space: normal; align-items: center; gap: 8px; padding-right: 10px; }
    .active-tag { display: inline-flex; align-items: center; background: #fff; color: #333; padding: 6px 12px; font-size: 0.8rem; font-weight: 600; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border: 1px solid #e0e0e0; flex-shrink: 0; height: 32px; margin-bottom: 4px; }
    
    .tag-type { border-left: 4px solid #3498db; } 
    .tag-price { border-left: 4px solid #f1c40f; background-color: #fffcf5; } 
    .tag-amenity { border-left: 4px solid #2ecc71; } 
    .btn-reset-mobile { width: 34px; height: 34px; background: #f8f9fa; color: #e74c3c; border: 1px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-top: 2px; }

    #toggle-filter-btn-container { display: none; }
    #toggle-filter-btn-container.visible { display: block !important; }

    .filter-label { font-weight: 700; font-size: 0.75rem; color: #666; margin-bottom: 4px; text-transform: uppercase; }
    
    .custom-check input { display: none; }
    .checkmark { height: 16px; width: 16px; border: 1px solid #f1c40f; background-color: white; border-radius: 3px; margin-right: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .custom-check input:checked ~ .checkmark { background-color: #f1c40f; }
    .custom-check input:checked ~ .checkmark:after { content: '\2713'; color: #212529; font-size: 11px; font-weight: bold; }

    @media (min-width: 992px) {
        #filter-form-body { display: block !important; height: auto !important; visibility: visible !important; }
        #toggle-filter-btn-container { display: none !important; }
        .mobile-filter-bar { display: none !important; }
    }

    .dropdown-item { padding: 12px 20px !important; font-size: 1rem !important; font-weight: 500; border-bottom: 1px solid #f0f0f0; }
    .dropdown-item:last-child { border-bottom: none; }
</style>

<script is:inline>
    // --- HÀM XỬ LÝ SLUG TIẾNG VIỆT CHUẨN ---
    function createSlug(str) {
        if (!str) return '';
        return str.toString().toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/[đĐ]/g, 'd')
            .replace(/[^a-z0-9\s]/g, '')
            .trim()
            .replace(/\s+/g, '-');
    }

    // 1. Helper: Hàm chọn Item trong Dropdown
    window.selectItem = function(element, inputId, btnId) {
        event.preventDefault();
        const value = element.getAttribute('data-value');
        const input = document.getElementById(inputId);
        if(input) input.value = value;

        const btn = document.getElementById(btnId);
        if(btn) btn.textContent = element.textContent;
        const menu = element.closest('.dropdown-menu');
        menu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
        element.classList.add('active');
    };

    // 2. Helper: Khôi phục trạng thái Dropdown
    function restoreDropdownState(inputId, btnId, targetValue) {
        const input = document.getElementById(inputId);
        const btn = document.getElementById(btnId);
        if (!input || !btn || !targetValue) return;

        input.value = targetValue;
        const menu = btn.nextElementSibling;
        let targetItem = null;
        
        if (targetValue === 'all') {
            targetItem = menu.querySelector(`.dropdown-item[data-value="all"]`);
        } else {
            targetItem = menu.querySelector(`.dropdown-item[data-value="${targetValue}"]`);
        }
        
        if (targetItem) {
            btn.textContent = targetItem.textContent;
            menu.querySelectorAll('.dropdown-item').forEach(item => item.classList.remove('active'));
            targetItem.classList.add('active');
        }
    }

    // 3. Logic Lọc
    function handleApplyFilter() {
        const district = document.getElementById('sb-district').value;
        const type = document.getElementById('sb-type').value;
        const price = document.getElementById('sb-price').value;
        const amenities = [];
        document.querySelectorAll('.sb-amenity:checked').forEach(cb => amenities.push(cb.value));

        const params = new URLSearchParams(window.location.search);
        type !== 'all' ? params.set('type', type) : params.delete('type');
        price !== 'all' ? params.set('price', price) : params.delete('price');
        amenities.length > 0 ? params.set('amenities', amenities.join(',')) : params.delete('amenities');
        
        params.delete('district');
        
        // Logic xác định thành phố dựa trên URL hiện tại
        let cityPrefix = '/ho-chi-minh';
        if (window.location.pathname.includes('/ha-noi')) {
            cityPrefix = '/ha-noi';
        }

        let targetPath = cityPrefix;

        if (district !== 'all') {
            targetPath = cityPrefix + '/' + createSlug(district);
        }

        const finalUrl = `${targetPath}${params.toString() ? '?' + params.toString() : ''}`;
        window.location.href = finalUrl;
    }

    window.expandFilter = function() {
        const el = document.getElementById('filter-form-body');
        const toggleBtn = document.getElementById('toggle-filter-btn-container');
        
        if (el) {
            // 1. [QUAN TRỌNG] Phải xóa display:none đã gán lúc ẩn đi
            el.style.removeProperty('display');
            
            // 2. Kích hoạt Bootstrap Show
            if (typeof window.bsCollapse === 'function') {
                window.bsCollapse('filter-form-body', 'show');
            }
            // 3. Fallback thêm class thủ công
            el.classList.add('show');
        }

        // Ẩn nút kích hoạt đi
        if (toggleBtn) {
            toggleBtn.classList.remove('visible');
            // Dùng style none để ẩn hoàn toàn
            toggleBtn.style.display = 'none';
        }
    };

    window.handleResetFilter = function(e) {
        if(e) e.stopPropagation();
        window.location.href = window.location.pathname;
    };

    function renderMobileActiveTags() {
        const container = document.getElementById('filter-tags-container');
        const bar = document.getElementById('mobile-filter-bar');
        if (!container || !bar) return false;

        const params = new URLSearchParams(window.location.search);
        let tagsHtml = '';
        let hasFilter = false;

        if(params.get('type') && params.get('type') !== 'all') { 
            tagsHtml += `<span class="active-tag tag-type">${params.get('type')}</span>`;
            hasFilter = true; 
        }
        
        const p = params.get('price');
        if (p && p !== 'all') {
            let label = p === 'duoi-5' ? '< 5 Triệu' : (p === '5to8' ? '5-8 Triệu' : '> 8 Triệu');
            tagsHtml += `<span class="active-tag tag-price">${label}</span>`;
            hasFilter = true;
        }

        const ams = params.get('amenities');
        if(ams) {
            ams.split(',').forEach(a => {
                tagsHtml += `<span class="active-tag tag-amenity">${a}</span>`;
            });
            hasFilter = true;
        }

        container.innerHTML = tagsHtml;
        if (window.innerWidth < 992) {
            hasFilter ? bar.classList.add('is-visible') : bar.classList.remove('is-visible');
        }
        return hasFilter;
    }

    // 4. MAIN EXECUTION
    // 4. MAIN EXECUTION (Đã sửa lỗi Mobile Bar)
    function initSidebarEvents() {
        const btnApply = document.getElementById('btn-apply');
        const btnReset = document.getElementById('btn-reset');
        const btnClearMobile = document.getElementById('btn-clear-mobile');
        const btnToggle = document.getElementById('btn-toggle-filter');
        const mobileBar = document.getElementById('mobile-filter-bar');
        
        // --- 1. GÁN SỰ KIỆN CÁC NÚT CHÍNH ---
        if (btnApply) btnApply.onclick = handleApplyFilter;
        if (btnReset) btnReset.onclick = window.handleResetFilter;
        if (btnToggle) btnToggle.onclick = window.expandFilter;

        // --- 2. XỬ LÝ MOBILE STICKY BAR (Sửa lại hoàn toàn) ---
        
        // A. Nút Xóa lọc trên Mobile
        if (btnClearMobile) {
            btnClearMobile.onclick = function(e) {
                // [QUAN TRỌNG] Ngăn sự kiện click lan ra ngoài (để không kích hoạt scroll của thanh bar)
                e.stopPropagation(); 
                window.handleResetFilter(e);
            };
        }

        // B. Thanh Bar (Click để cuộn lên và mở filter)
        if (mobileBar) {
            // Gán trực tiếp onclick (Tự động ghi đè sự kiện cũ, không cần cloneNode)
            mobileBar.onclick = function() {
                const sidebar = document.getElementById('sidebar-wrapper');
                // 1. Cuộn đến vị trí bộ lọc
                if(sidebar) {
                    // Dùng 'start' để mép trên bộ lọc căn đúng đỉnh màn hình
                    sidebar.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                // 2. Mở bung bộ lọc ra
                window.expandFilter();
            };
        }

        // --- 3. KHÔI PHỤC TRẠNG THÁI TỪ URL (Giữ nguyên logic cũ) ---
        const params = new URLSearchParams(window.location.search);
        
        let currentPathDist = 'all';
        const pathSegments = window.location.pathname.split('/').filter(Boolean);
        
        if (pathSegments.length > 0) {
            const districtLinks = document.querySelectorAll('#btn-display-district + .dropdown-menu .dropdown-item');
            pathSegments.forEach(segment => {
                districtLinks.forEach(link => {
                    const val = link.getAttribute('data-value');
                    if (val !== 'all' && createSlug(val) === segment) {
                        currentPathDist = val; 
                    }
                });
            });
        }
        
        restoreDropdownState('sb-district', 'btn-display-district', currentPathDist);
        restoreDropdownState('sb-type', 'btn-display-type', params.get('type') || 'all');
        restoreDropdownState('sb-price', 'btn-display-price', params.get('price') || 'all');

        const ams = params.get('amenities');
        if (ams) {
            const list = ams.split(',');
            document.querySelectorAll('.sb-amenity').forEach(cb => {
                if (list.includes(cb.value)) cb.checked = true;
            });
        }

        // Xử lý hiển thị ban đầu trên Mobile
        const hasFilter = renderMobileActiveTags();
        if (window.innerWidth < 992) {
            const toggleBtn = document.getElementById('toggle-filter-btn-container');
            
            if (hasFilter) {
                // Nếu đang có lọc -> Ẩn form đi để hiện thanh sticky bar
                if (typeof window.bsCollapse === 'function') {
                    window.bsCollapse('filter-form-body', 'hide');
                }
                // Fallback an toàn
                const formBody = document.getElementById('filter-form-body');
                if(formBody) {
                    formBody.classList.remove('show');
                    formBody.style.display = 'none'; // Cưỡng chế ẩn
                }

                if (toggleBtn) {
                    toggleBtn.classList.add('visible');
                    toggleBtn.style.display = 'block';
                }
            } else {
                // Nếu không lọc -> Hiện nút "Hiển thị bộ lọc" bình thường (hoặc ẩn tùy logic CSS)
                if (toggleBtn) toggleBtn.classList.remove('visible');
            }
        }
    }
    // CHẠY HÀM KHỞI TẠO (Hỗ trợ cả load thường và Astro SPA)
    document.addEventListener('DOMContentLoaded', initSidebarEvents);
</script>