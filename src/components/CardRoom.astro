---
const { room, priority = false, citySlug = 'ho-chi-minh' } = Astro.props;
function hideNumber(address) {
    if (!address) return "";
    return address.replace(/^[0-9][0-9a-zA-Z\/,.-]*\s+/, '');
}

function formatPrice(price) {
    if (price >= 1000000) return (price / 1000000).toString() + " Triệu";
    return new Intl.NumberFormat('vi-VN').format(price);
}


function createSlug(str) {
    if (!str) return '';
    return str.toString().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Bỏ dấu
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9\s]/g, '')
        .trim()
        .replace(/\s+/g, '-');
}

// --- LOGIC ẢNH MỚI (Ghép ID thành Link) ---
const IMG_BASE_URL = "https://img.thochothuetro.com";
let displayImage = '/logo.png';
// 1. Ưu tiên dùng trường image_thumb (ID ảnh thumb chuẩn)
if (room.image_thumb) {
    displayImage = `${IMG_BASE_URL}/${room.image_thumb}_thumb.webp`;
} 
// 2. Fallback: Nếu không có thumb, lấy ảnh đầu tiên trong detail (dùng bản medium cho nhẹ)
else if (room.image_detail && room.image_detail.length > 0) {
    displayImage = `${IMG_BASE_URL}/${room.image_detail[0]}_medium.webp`;
}

const cardTitle = `Cho thuê căn ${room.type} ${hideNumber(room.address)}`;
const detailLink = `/${citySlug}/${createSlug(room.district)}/${room.id}`;
const isRented = room.status === 'rented';
---

<div class={`card h-100 border-0 shadow-sm room-card rounded-3 overflow-hidden position-relative ${isRented ? 'rented-card' : ''}`}>
   <a href={detailLink} class="stretched-link"></a>

    <div class="position-relative">
        <img src={displayImage} 
             class="card-img-top room-img" 
             alt={`Cho thuê ${room.type} ${room.address}, ${room.district}`}
             width="400" height="300"
             loading={priority ? "eager" : "lazy"} 
             fetchpriority={priority ? "high" : "low"}
             decoding="async"
             style="aspect-ratio: 4/3; object-fit: cover; width: 100%; height: auto;">
        
        {isRented && (
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center rented-overlay" style="background: rgba(0,0,0,0.6); z-index: 5;">
                <span class="text-white fw-bold border border-white px-3 py-2 rounded text-uppercase" style="letter-spacing: 1px;">
                    Đã cho thuê
                </span>
            </div>
        )}

        {!isRented && room.promotion && (
            <span class="position-absolute top-0 end-0 bg-warning text-dark px-1 px-md-2 py-1 fw-bold m-1 m-md-2 rounded shadow-sm d-flex align-items-center badge-promo" style="z-index: 2;">
                <i class="fas fa-gift me-1 text-dark"></i> Ưu đãi
            </span>
        )}
    </div>
    
    <div class="card-body p-2 p-md-3 d-flex flex-column">
        <h6 class="fw-bold text-dark mb-1 mb-md-2 room-title">
            {cardTitle}
        </h6>
    
        <div class="mb-1 mb-md-2">
            <span class="badge bg-light text-dark border fw-normal room-code">
                {room.room_code}
            </span>
        </div>
        <div class="mb-1 mb-md-2">
            <span class={`fw-bold room-price ${isRented ? 'text-secondary text-decoration-line-through' : 'text-danger'}`}>
                {formatPrice(room.price)}/tháng
            </span>
        </div>
        <div class="mb-2 mb-md-3 text-muted room-keypoint text-truncate-2">
            <i class="fas fa-star text-warning me-1"></i> {room.keypoint ? room.keypoint.split('|')[0] : ''}
        </div>
        <div class="mt-auto">
            <hr class="my-1 my-md-2 opacity-25">
            <div class="d-flex align-items-center text-muted small room-district">
                <i class="fas fa-map-marker-alt me-1 me-md-2 text-warning"></i> 
                Quận {room.district}
            </div>
        </div>
    </div>

    <a href={detailLink} class="stretched-link"></a>
</div>

<style>
    /* 4. CARD (THẺ PHÒNG TRỌ) - Di chuyển từ style.css */
    .room-card {
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
        height: 100%;
        display: flex; flex-direction: column;
        border: 1px solid #eee;
    }

    .room-card .card-body { flex: 1; display: flex; flex-direction: column; }

    /* Hiệu ứng hover chỉ khi CHƯA thuê */
    .room-card:not(.rented-card):hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        border-color: #f1c40f; /* var(--primary) */
    }

    .room-card .card-img-top {
        height: 200px;
        width: 100%;
        object-fit: cover;
    }

    /* Style cho căn ĐÃ THUÊ */
    .room-card.rented-card {
        opacity: 0.9; 
        filter: grayscale(30%); 
        cursor: pointer;
    }
    
    /* Vẫn cho click để xem chi tiết */
    .rented-card .stretched-link { pointer-events: auto; } 

    .rented-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
    }

    .room-title { font-size: 1rem; line-height: 1.4; }
    .room-price { font-size: 1.1rem; }
    .room-keypoint { font-size: 0.95rem; }
    .room-code { font-size: 0.75rem; }
    .room-district { font-size: 0.85rem; }
    .badge-promo { font-size: 0.75rem; }
    
    .text-truncate-2 { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }

    /* RESPONSIVE */
    @media (max-width: 576px) {
        .room-title { font-size: 0.95rem; margin-bottom: 4px; }
        .room-price { font-size: 0.95rem; }
        .room-keypoint { font-size: 0.9rem; }
        .room-code { font-size: 0.65rem; }
        .badge-promo { font-size: 0.6rem; padding: 2px 4px !important; }
        .room-district { font-size: 0.8rem; }
    }
    
    @media(min-width: 768px) { 
        .text-truncate-2 { -webkit-line-clamp: 3; } 
    }
    
    @media (max-width: 991px) {
        .room-card .card-img-top { height: 180px; }
    }
</style>