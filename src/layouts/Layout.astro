---
// Import trực tiếp từ node_modules 
import { ViewTransitions } from 'astro:transitions';
import fs from 'node:fs';
import path from 'node:path';
import '../styles/main.scss';
import '../styles/style.css';

export interface Props {
    title: string;
    description?: string;
    image?: string;
    preloadImage?: string;
    canonicalURL?: string;
}

const { 
    title, 
    description = "Hệ thống phòng trọ tiện nghi, giờ giấc tự do tại Tân Bình & Phú Nhuận. Cam kết hình thật, giá thật.",
    image = "/logo.png",
    preloadImage,
    canonicalURL
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteURL = Astro.site || 'https://thochothuetro.com';
const fullURL = canonicalURL || `${siteURL}${currentPath}`;
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ViewTransitions />
    
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#d9b205" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://img.thochothuetro.com">
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">

    {preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
    </noscript>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" media="print" onload="this.media='all'" crossorigin="anonymous" />
    <noscript><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"></noscript>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" media="print" onload="this.media='all'" crossorigin="anonymous">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"></noscript>
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullURL} />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteURL}${image}`} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Thọ Cho Thuê Trọ" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${image}`} />
    
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content="Thọ Cho Thuê Trọ" />
    <meta name="geo.region" content="VN-SG" />
    <meta name="geo.placename" content="Ho Chi Minh City" />
    
    <slot name="head" />

    <style is:global>
        /* --- CRITICAL CSS --- */
        :root {
            --bs-font-sans-serif: 'Be Vietnam Pro', sans-serif;
            --primary-color: #d9b205;
            --warning-color: #d9b205;
        }

        /* 1. Thiết lập HTML/Body chuẩn */
        html, body {
            height: auto !important;
        }

        body { 
            font-family: var(--bs-font-sans-serif);
            background-color: #f8f9fa; 
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            /* Padding bottom cho thanh menu dưới */
            padding-bottom: 80px !important;
        }

        /* 2. Main chiếm phần còn lại */
        main { 
            flex: 1 0 auto;
            width: 100%;
        }

        /* Navbar Brand */
        .navbar-brand img { 
            height: 48px;
            width: auto; 
            box-shadow: none !important;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #999; }

    /* =========================================================
       4. FIX MENU MOBILE - PHIÊN BẢN HOÀN THIỆN (FINAL)
       ========================================================= */
    @media (max-width: 991px) {
        .app-offcanvas {
            /* 1. VỊ TRÍ & KÍCH THƯỚC */
            position: fixed !important;
            top: 0 !important;
            bottom: 0 !important;
            right: 0 !important;
            left: auto !important;
            width: 85vw !important;
            max-width: 320px !important;
            height: 100vh !important;
            background-color: #ffffff !important;
            z-index: 1050 !important;
            box-shadow: -5px 0 30px rgba(0,0,0,0.15) !important;
            border-left: 1px solid rgba(0,0,0,0.05) !important;

            /* 2. TRẠNG THÁI ĐÓNG */
            transform: translate3d(100%, 0, 0) !important;
            visibility: hidden !important;
            transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), visibility 0s linear 0.4s !important;
            display: flex !important;
            flex-direction: column !important;
        }

        /* 3. TRẠNG THÁI MỞ & ĐANG MỞ */
        .app-offcanvas.show,
        .app-offcanvas.showing { 
            transform: translate3d(0, 0, 0) !important;
            visibility: visible !important;
            transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), visibility 0s linear 0s !important;
        }

        /* 4. TRẠNG THÁI ĐANG ĐÓNG */
        .app-offcanvas.hiding {
            transform: translate3d(100%, 0, 0) !important;
            visibility: visible !important; 
            transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        }

        /* Nội dung bên trong */
        .offcanvas-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 20px;
            border-bottom: 1px solid #f2f2f2;
            min-height: 70px;
        }

        .offcanvas-body {
            flex-grow: 1;
            padding: 20px;
            overflow-y: auto !important;
            overscroll-behavior: contain;
        }
        
        .btn-close {
            opacity: 1 !important;
            padding: 10px !important;
            margin: 0 !important;
            box-shadow: none !important;
        }
        
        .offcanvas-header img {
            width: 40px !important;
            height: 40px !important;
            object-fit: contain;
            flex-shrink: 0;
            border-radius: 6px;
        }
    

        /* Link menu trong mobile */
        .navbar-nav .nav-item {
            width: 100%;
            margin-bottom: 0.5rem;
        }

        .navbar-nav .nav-link {
            padding: 12px 16px !important;
            border-radius: 12px;
            background-color: #f8f9fa;
            color: #333 !important;
            font-weight: 600;
            font-size: 15px;
            display: flex;
            align-items: center;
            transition: all 0.2s;
        }

        .navbar-nav .nav-link:active {
            background-color: #fffbe6;
            color: #d9b205 !important;
            transform: scale(0.97);
        }

        .social-icon-mobile {
            width: 44px;
            height: 44px;
            background: #f8f9fa;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #333;
            text-decoration: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
    }
        /* --- DESKTOP STYLES (>= 992px) --- */
        @media (min-width: 992px) {
            .mobile-bottom-nav { display: none !important; } 
            .btn-call-mobile { display: none !important; }
            
            .nav-link { 
                font-weight: 600;
                color: #444 !important; 
                padding: 0.5rem 1rem !important;
                transition: all 0.2s;
            }
            .nav-link:hover, .nav-link.active { 
                color: #d9b205 !important;
            }
        }

        /* =========================================
       MOBILE BOTTOM NAVIGATION - NATIVE APP STYLE
       ========================================= */
    @media (max-width: 991px) {

        /* 1. Tạo khoảng trống đáy */
        body { 
            padding-bottom: 80px !important;
            background-color: #f8f9fa; 
        }

        /* 2. Container chính */
        .mobile-bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 68px;
            
            /* Hiệu ứng kính mờ */
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 199;
            padding-bottom: env(safe-area-inset-bottom);
        }

        /* 3. Style chung cho từng nút */
        .nav-item-mobile {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border: none;
            background: none;
            padding: 8px 0;
            color: #8e8e93;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            -webkit-tap-highlight-color: transparent;
        }

        /* Icon và Text */
        .nav-item-mobile i {
            font-size: 22px;
            margin-bottom: 4px;
        }

        .nav-item-mobile span {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.2px;
        }

        /* 4. Trạng thái ACTIVE */
        .nav-item-mobile.active {
            color: #d9b205;
        }
        .nav-item-mobile.active span {
            font-weight: 700;
        }

        /* 5. Màu sắc riêng cho các nút chức năng */
        .nav-item-mobile.share-btn:active i {
            color: #28a745;
            transform: scale(1.1);
        }

        .nav-item-mobile.zalo-btn {
            color: #0068ff;
            opacity: 0.9;
        }
        .nav-item-mobile.zalo-btn span {
             font-weight: 600;
        }
        
        .nav-item-mobile:not(.active):not(.zalo-btn):active {
             color: var(--primary-color);
             transform: scale(0.95);
        }
    }
           /* =========================================
       HEADER NAVIGATION - GLASSMORPHISM STYLE
       ========================================= */
    
    /* 1. Header chính */
    .app-header {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 1px 15px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        padding: 10px 0;
        z-index: 1040;
    }
    
    .brand-text {
        font-size: 1.1rem;
        color: #d9b205 !important;
        letter-spacing: -0.5px;
    }
    
    .brand-slogan {
        font-size: 0.75rem;
        font-weight: 500;
    }

    /* 2. Hamburger Icon */
    .hamburger-icon {
        width: 24px;
        height: 18px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
    }
    .hamburger-icon span {
        display: block;
        width: 100%;
        height: 2px;
        background-color: #333;
        border-radius: 2px;
    }

    /* 3. Nút Call Action trên Header */
    .btn-header-cta {
        background: #d9b205 !important;
        border: none;
        color: #1a1a1a !important;
        padding: 8px 20px;
        transition: transform 0.2s;
    }
    .btn-header-cta:active {
        transform: scale(0.96);
    }
    
    /* Hiệu ứng rung icon điện thoại */
    @keyframes ring {
        0% { transform: rotate(0); }
        10% { transform: rotate(30deg); }
        30% { transform: rotate(-28deg); }
        50% { transform: rotate(34deg); }
        70% { transform: rotate(-32deg); }
        90% { transform: rotate(30deg); }
        100% { transform: rotate(0); }
    }
    .animate-ring {
        animation: ring 4s infinite ease-in-out;
    }

    /* 5. Desktop Adjustments */
    @media (min-width: 992px) {
        .app-offcanvas {
            visibility: visible !important;
            display: flex !important;
            transform: none !important;
            position: static !important;
            height: auto !important;
            width: auto !important;
            background: transparent !important;
            box-shadow: none !important;
        }
        .nav-link:hover {
            color: #d9b205 !important;
            background: rgba(217, 178, 5, 0.08);
        }
    } 

        /* --- FOOTER STYLES --- */
        footer {
            background-color: #1a1a1a;
            color: #e0e0e0;
            flex-shrink: 0;
        }

        footer a {
            color: #e0e0e0;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        footer a:hover {
            color: var(--warning-color);
        }

        .footer-logo {
            height: 60px;
            width: auto;
            border-radius: 8px;
        }

        .social-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 50%;
            margin-right: 12px;
            font-size: 18px;
            transition: all 0.3s ease;
        }

        .social-link:hover {
            background: var(--warning-color);
            color: #1a1a1a !important;
            transform: translateY(-3px);
        }
        @media (min-width: 992px) {
        .app-offcanvas {
            display: none !important;
        }
        .navbar-nav .nav-link {
            color: #333 !important;
        }
        .navbar-nav .nav-link:hover {
            color: #d9b205 !important;
            background: rgba(217, 178, 5, 0.1);
        }
    }
    /* =========================================================
           FIX LỖI STICKY SIDEBAR (QUAN TRỌNG)
           Bắt buộc các thẻ bao quanh Sidebar phải cho phép hiển thị tràn (visible)
           Nếu để hidden/auto/scroll thì Sticky sẽ chết.
        ========================================================= */
        
        /* 1. Đảm bảo thẻ html/body cuộn tự nhiên, không tạo scroll ảo */
        html, body {
            overflow-x: clip !important; /* Dùng clip thay vì hidden để an toàn hơn cho sticky */
            overflow-y: visible !important; /* Để trình duyệt quản lý thanh cuộn */
        }

        /* 2. Cứu cánh cho thẻ Main và Container */
        main, 
        .container, 
        .row,
        .col-lg-3, 
        aside {
            overflow: visible !important; 
        }

        /* 3. Ép cột Sidebar và cột Nội dung cao bằng nhau (Flex Stretch) */
        /* Đây là điều kiện tiên quyết để sidebar có "đường ray" để trượt */
        .row {
            align-items: stretch !important;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top app-header">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <img src="/logo.png" alt="Thọ Cho Thuê Trọ" width="45" height="45" class="app-logo">
                <div class="d-flex flex-column">
                    <span class="brand-text fw-bold text-dark lh-1">THỌ CHO THUÊ TRỌ</span>
                    <span class="brand-slogan text-muted d-none d-sm-block">Hệ thống phòng trọ tiện nghi</span>
                </div>
            </a>

            <button class="navbar-toggler border-0 p-0 shadow-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appMenu" aria-controls="appMenu" aria-label="Mở menu">
                <div class="hamburger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </button>
            <div class="collapse navbar-collapse justify-content-end d-none d-lg-flex" id="desktopMenu">
                <ul class="navbar-nav align-items-center gap-3">
                    <li class="nav-item">
                        <a class="nav-link fw-bold px-3 py-2 rounded-pill" href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold px-3 py-2 rounded-pill" href="/tan-binh">Quận Tân Bình</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold px-3 py-2 rounded-pill" href="/phu-nhuan">Quận Phú Nhuận</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold px-3 py-2 rounded-pill" href="/map-search">Bản đồ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold px-3 py-2 rounded-pill" href="/contact">Liên hệ</a>
                    </li>
                    <li class="nav-item ms-2">
                        <a href="tel:0925996992" class="btn btn-primary rounded-pill fw-bold px-4 py-2 shadow-sm btn-header-cta d-flex align-items-center gap-2">
                            <i class="fas fa-phone-alt animate-ring"></i> 
                            <span>0925 996 992</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        <slot />
    </main>

    <footer id="footer-contact" class="pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="/logo.png" alt="Thọ Cho Thuê Trọ Logo" class="footer-logo" width="60" height="60" loading="lazy">
                        <div>
                            <h5 class="mb-1 text-warning">THỌ CHO THUÊ TRỌ</h5>
                            <span class="badge bg-light text-dark fw-bold">Hệ thống phòng trọ tiện nghi</span>
                        </div>
                    </div>
                    
                    <p class="text-light text-warning mb-4" style="line-height: 1.6; opacity: 0.9;">
                        Chúng tôi cam kết mang đến không gian sống an ninh, sạch sẽ và tiện nghi tại Tân Bình & Phú Nhuận.
                        Hình ảnh thực tế 100%, giá cả minh bạch, hỗ trợ xem phòng hoàn toàn miễn phí.
                    </p>

                    <div class="d-flex" role="navigation" aria-label="Social media links">
                        <a href="https://www.facebook.com/profile.php?id=61584268626330" target="_blank" rel="noopener noreferrer" class="social-link" title="Theo dõi trên Facebook" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        
                        <a href="https://www.tiktok.com/@thochothuetroo" target="_blank" rel="noopener noreferrer" class="social-link" title="Xem video trên TikTok" aria-label="TikTok">
                            <i class="fab fa-tiktok"></i>
                        </a>
                        
                        <a href="https://www.youtube.com/@thochothuetro" target="_blank" rel="noopener noreferrer" class="social-link" title="Đăng ký kênh YouTube" aria-label="YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                        
                        <a href="https://zalo.me/0925996992" target="_blank" rel="noopener noreferrer" class="social-link" title="Chat Zalo ngay" aria-label="Zalo">
                            <i class="fas fa-comment-dots"></i>
                        </a>
                    </div>
                </div>

                <div class="col-6 col-lg-3 ps-lg-5">
                    <h6 class="mb-4 text-white border-bottom border-secondary d-inline-block pb-1">KHU VỰC</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/tan-binh"><i class="fas fa-angle-right me-2 text-warning small"></i>Phòng trọ Tân Bình</a></li>
                        <li class="mb-2"><a href="/phu-nhuan"><i class="fas fa-angle-right me-2 text-warning small"></i>Phòng trọ Phú Nhuận</a></li>
                        <li class="mb-2"><a href="/map-search"><i class="fas fa-angle-right me-2 text-warning small"></i>Tìm trên bản đồ</a></li>
                        <li class="mb-2"><a href="/"><i class="fas fa-angle-right me-2 text-warning small"></i>Tất cả phòng</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-4">
                    <h6 class="mb-4 text-white border-bottom border-secondary d-inline-block pb-1">LIÊN HỆ</h6>
                    <ul class="list-unstyled">
                        <li class="mb-3 d-flex">
                            <i class="fas fa-map-marker-alt text-warning mt-1 me-3"></i>
                            <span class="text-white">Hoạt động tại: Quận Tân Bình & Phú Nhuận, TP.HCM</span>
                        </li>
                        <li class="mb-3 d-flex">
                            <i class="fas fa-phone-alt text-warning mt-1 me-3"></i>
                            <div>
                                <a href="tel:0925996992" class="d-block text-white fw-bold">0925 996 992</a>
                                <span class="small text-white-50">(Zalo / Call / SMS)</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-top border-secondary mt-5 pt-4 text-center">
                <p class="small text-white-50 mb-0">
                    &copy; {new Date().getFullYear()} <strong>Thọ Cho Thuê Trọ</strong>.
                    All rights reserved. <br class="d-lg-none">
                    Designed for your comfort.
                </p>
            </div>
        </div>
    </footer>

    <div class="mobile-bottom-nav">
        <a href="/map-search" class={`nav-item-mobile ${currentPath.includes('map-search') ? 'active' : ''}`}>
            <i class="fas fa-map-marked-alt"></i>
            <span>Bản đồ</span>
        </a>

        <button id="mobile-share-btn" class="nav-item-mobile share-btn">
            <i class="fas fa-share-alt"></i>
            <span>Chia sẻ</span>
        </button>

        <a href="https://zalo.me/0925996992" target="_blank" class="nav-item-mobile zalo-btn">
            <i class="fas fa-comment-dots"></i>
            <span>Zalo</span>
        </a>
    </div>

    <script>
        import "../scripts/bootstrap-custom.js";
    </script>

    <script is:inline>
        // Mobile share functionality
        document.addEventListener('astro:page-load', () => {
            const shareBtn = document.getElementById('mobile-share-btn');
            if (shareBtn) {
                shareBtn.addEventListener('click', async () => {
                    const shareData = {
                        title: document.title,
                        text: 'Phòng trọ đẹp, giá tốt tại Tân Bình & Phú Nhuận:',
                        url: window.location.href
                    };
                    if (navigator.share) {
                        try { 
                            await navigator.share(shareData); 
                        } catch (err) {
                            console.log('Share cancelled');
                        }
                    } else {
                        try { 
                            await navigator.clipboard.writeText(window.location.href);
                            alert('Đã sao chép liên kết!');
                        } catch (err) {
                            console.log('Copy failed');
                        }
                    }
                });
            }
        });
    </script>

