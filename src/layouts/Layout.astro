// Import trực tiếp từ node_modules 
import { ViewTransitions } from 'astro:transitions';
import fs from 'node:fs';
import path from 'node:path';


// Khai báo kiểu dữ liệu cho Props (TypeScript)
export interface Props {
    title: string;
    description?: string;
    image?: string;
    preloadImage?: string;
    canonicalURL?: string;
    currentCity?: string;
}

const { 
    title, 
    description = "Hệ thống phòng trọ tiện nghi, giờ giấc tự do tại Tân Bình & Phú Nhuận. Cam kết hình thật, giá thật.",
    image = "/logo.png",
    preloadImage,
    canonicalURL,
    currentCity 
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteURL = Astro.site || 'https://thochothuetro.com';
const fullURL = canonicalURL || `${siteURL}${currentPath}`;

// --- [LOGIC QUAN TRỌNG] Kiểm tra xem có phải trang bản đồ không ---
const isMapPage = currentPath.includes('/map-search');

// 1. Luôn tải Main SCSS (Bootstrap)
import "../styles/main.scss";

// 2. Tải style.css có điều kiện (Dùng await import để tránh lỗi Syntax)
if (!isMapPage) {
    await import('../styles/style.css');
}

// --- [MỚI] LOGIC LẤY MENU ĐỘNG TỪ DATA (ĐÃ FIX TYPESCRIPT) ---
// Thêm : string[] để báo đây là danh sách các chuỗi ký tự
let menuDistricts: string[] = []; 
let citySlug = '';
let cityName = '';

let otherCityName = '';
let otherCitySlug = '';

// Thêm (str: any) để tránh lỗi "implicitly has an 'any' type"
function createSlug(str: any) {
    if (!str) return '';
    return str.toString().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/[^a-z0-9\s]/g, '')
        .trim()
        .replace(/\s+/g, '-');
}

if (currentCity) {
    citySlug = currentCity === 'hanoi' ? 'ha-noi' : 'ho-chi-minh';
    cityName = currentCity === 'hanoi' ? 'Hà Nội' : 'Hồ Chí Minh';
    
    otherCityName = currentCity === 'hanoi' ? 'Hồ Chí Minh' : 'Hà Nội';
    otherCitySlug = currentCity === 'hanoi' ? 'ho-chi-minh' : 'ha-noi';

    try {
        const fileName = currentCity === 'hanoi' ? 'data_hanoi.json' : 'data_hochiminh.json';
        const dataPath = path.join(process.cwd(), 'public', fileName);
        
        if (fs.existsSync(dataPath)) {
            const jsonData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
            // Thêm : any[] để TypeScript không bắt bẻ biến rooms
            const rooms: any[] = jsonData.rooms || [];

            // Logic lọc quận (đã an toàn với TypeScript)
            menuDistricts = [...new Set(rooms.map((r: any) => r.district).filter((d: any) => d))].sort() as string[];
        }
    } catch (e) {
        console.error("Error loading menu data:", e);
        menuDistricts = [];
    }
}
